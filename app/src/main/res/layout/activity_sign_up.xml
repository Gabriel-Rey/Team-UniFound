<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context=".SignUpActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="40dp"
            android:paddingBottom="24dp">

            <!-- Logo and Title -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical"
                android:layout_marginBottom="24dp">

                <ImageView
                    android:id="@+id/ivLogo"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:src="@drawable/unifound"
                    android:contentDescription="UniFound Logo" />

                <TextView
                    android:id="@+id/tvUniFound"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="UniFound"
                    android:textSize="20sp"
                    android:textColor="#1E1E2A"
                    android:textStyle="bold"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:id="@+id/tvSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LOST &amp; FOUND PORTAL"
                    android:textSize="10sp"
                    android:textColor="#888888"
                    android:letterSpacing="0.15" />

            </LinearLayout>

            <!-- Create Account Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Create Account"
                android:textSize="28sp"
                android:textColor="#1E1E2A"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Join UniFound and start reporting lost &amp; found items on campus"
                android:textSize="14sp"
                android:textColor="#666666"
                android:layout_marginBottom="24dp" />

            <!-- Personal Information Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PERSONAL INFORMATION"
                android:textSize="14sp"
                android:textColor="#1E1E2A"
                android:textStyle="bold"
                android:layout_marginBottom="16dp" />

            <!-- First Name -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilFirstName"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="FIRST NAME"
                android:layout_marginBottom="16dp"
                app:boxStrokeColor="#1E1E2A"
                app:boxStrokeWidth="2dp"
                app:hintTextColor="#1E1E2A">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etFirstName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPersonName"
                    android:textColor="#1E1E2A"
                    android:textSize="14sp" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Last Name -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilLastName"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="LAST NAME"
                android:layout_marginBottom="16dp"
                app:boxStrokeColor="#1E1E2A"
                app:boxStrokeWidth="2dp"
                app:hintTextColor="#1E1E2A">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etLastName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPersonName"
                    android:textColor="#1E1E2A"
                    android:textSize="14sp" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- University Email -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilUniversityEmail"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="UNIVERSITY EMAIL"
                android:layout_marginBottom="16dp"
                app:boxStrokeColor="#1E1E2A"
                app:boxStrokeWidth="2dp"
                app:hintTextColor="#1E1E2A">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etUniversityEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textEmailAddress"
                    android:textColor="#1E1E2A"
                    android:textSize="14sp" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Student/Staff ID -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilStudentId"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="STUDENT / STAFF ID"
                android:layout_marginBottom="16dp"
                app:boxStrokeColor="#1E1E2A"
                app:boxStrokeWidth="2dp"
                app:hintTextColor="#1E1E2A">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etStudentId"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:textColor="#1E1E2A"
                    android:textSize="14sp" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Faculty/Department Spinner -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilFaculty"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="FACULTY / DEPARTMENT"
                android:layout_marginBottom="24dp"
                app:boxStrokeColor="#1E1E2A"
                app:boxStrokeWidth="2dp"
                app:hintTextColor="#1E1E2A"
                app:endIconMode="dropdown_menu">

                <AutoCompleteTextView
                    android:id="@+id/actvFaculty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:textColor="#1E1E2A"
                    android:textSize="14sp" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Account Credentials Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ACCOUNT CREDENTIALS"
                android:textSize="14sp"
                android:textColor="#1E1E2A"
                android:textStyle="bold"
                android:layout_marginBottom="16dp"
                android:layout_marginTop="8dp" />

            <!-- Display Name/Username -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilUsername"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="DISPLAY NAME / USERNAME"
                android:layout_marginBottom="16dp"
                app:boxStrokeColor="#1E1E2A"
                app:boxStrokeWidth="2dp"
                app:hintTextColor="#1E1E2A">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etUsername"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:textColor="#1E1E2A"
                    android:textSize="14sp" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Password -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilPassword"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="PASSWORD"
                android:layout_marginBottom="8dp"
                app:boxStrokeColor="#1E1E2A"
                app:boxStrokeWidth="2dp"
                app:hintTextColor="#1E1E2A"
                app:endIconMode="password_toggle"
                app:endIconTint="#1E1E2A">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:textColor="#1E1E2A"
                    android:textSize="14sp" />

            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Min. 8 characters"
                android:textSize="11sp"
                android:textColor="#888888"
                android:layout_marginBottom="16dp"
                android:layout_marginStart="4dp" />

            <!-- Confirm Password -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilConfirmPassword"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="CONFIRM PASSWORD"
                android:layout_marginBottom="16dp"
                app:boxStrokeColor="#1E1E2A"
                app:boxStrokeWidth="2dp"
                app:hintTextColor="#1E1E2A"
                app:endIconMode="password_toggle"
                app:endIconTint="#1E1E2A">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etConfirmPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:textColor="#1E1E2A"
                    android:textSize="14sp" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Terms and Conditions Checkbox -->
            <CheckBox
                android:id="@+id/cbTerms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="I agree to the Terms &amp; Conditions and Privacy Policy of UniFound."
                android:textSize="13sp"
                android:textColor="#666666"
                android:layout_marginBottom="24dp" />

            <!-- Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="24dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBack"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="← Back"
                    android:textAllCaps="false"
                    android:textSize="14sp"
                    android:textColor="#1E1E2A"
                    app:strokeColor="#1E1E2A"
                    app:strokeWidth="2dp"
                    android:layout_marginEnd="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCreateAccount"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="Create Account"
                    android:textAllCaps="false"
                    android:textSize="14sp"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#1E1E2A"
                    app:cornerRadius="8dp"
                    android:layout_marginStart="12dp" />

            </LinearLayout>

            <!-- Sign In Link -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Already have an account? "
                    android:textSize="13sp"
                    android:textColor="#666666" />

                <TextView
                    android:id="@+id/tvSignInHere"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sign in here"
                    android:textSize="13sp"
                    android:textColor="#3B82F6"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>